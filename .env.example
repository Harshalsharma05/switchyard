# Copy to .env and fill in. .env is gitignored; this file is committed.
#
# Every variable named here is referenced by `api_key_env` in
# configs/providers.yaml. A provider whose variable is unset or empty fails
# startup with a message naming it — mark that provider `enabled: false`
# instead if you do not have its credential yet.

# --- Enabled providers -------------------------------------------------------

# Groq occupies the OpenAI slot during development (OpenAI-compatible endpoint).
GROQ_API_KEY=gsk_replace_me

# Gemini occupies the Anthropic slot during development.
GEMINI_API_KEY=replace_me

# Ollama runs locally and needs no credential.

# --- Disabled providers ------------------------------------------------------
# Set these and flip `enabled: true` in configs/providers.yaml to use the real
# providers instead of the stand-ins above.

# OPENAI_API_KEY=sk-replace_me
# ANTHROPIC_API_KEY=sk-ant-replace_me

# --- Postgres request log (Part 2) -----------------------------------------
# Backs the durable request-log table. DB name and user are both "switchyard"
# (set as literals in deploy/docker-compose.yml); only the password is a
# secret. Loaded into the postgres, migrate, and gateway containers via
# env_file, same as the provider keys above.
POSTGRES_PASSWORD=replace_me

# Connection settings for the gateway and the migrate step. All optional; the
# defaults shown are for host-run dev against the compose Postgres. Compose
# overrides SWITCHYARD_POSTGRES_HOST to the service name.
# SWITCHYARD_POSTGRES_HOST=localhost:5432
# SWITCHYARD_POSTGRES_USER=switchyard
# SWITCHYARD_POSTGRES_DB=switchyard
# SWITCHYARD_POSTGRES_SSLMODE=disable

# Retention: detail rows older than the window are rolled into requests_daily
# and deleted. Set the window to 0 to keep every row forever.
# SWITCHYARD_RETENTION_WINDOW=720h
# SWITCHYARD_RETENTION_INTERVAL=1h
# SWITCHYARD_RETENTION_BATCH_SIZE=5000

# --- Server ------------------------------------------------------------------
# All optional; the defaults shown are what the gateway uses if unset.

# SWITCHYARD_ADDR=:8080
# SWITCHYARD_ADMIN_ADDR=:9090
# SWITCHYARD_PROVIDERS_CONFIG=configs/providers.yaml
# SWITCHYARD_DRAIN_TIMEOUT=25s
# SWITCHYARD_LOG_LEVEL=info

# --- Alerting (Phase 10) ------------------------------------------------------
# Grafana's Slack contact point. Read by docker-compose.yml from the shell
# environment, not from this file directly (Compose only auto-loads a .env
# next to the compose file, i.e. deploy/.env) -- export it or add it there.
# Unset, provisioning still succeeds; alerts just fail to deliver.
# SWITCHYARD_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
